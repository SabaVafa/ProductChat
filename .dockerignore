# Keep the Docker build context small and reproducible.
# The demo image bakes its data from deploy/seed/, NOT the live working copies.
.git
.github
**/__pycache__
**/*.pyc
**/.venv
backend/.venv
backend/logs
backend/productchat.db
backend/qdrant_local
# Frontend is not needed — the backend serves the /widget-demo page itself.
frontend
**/node_modules
# Docs not needed in the image.
*.md
# The seed is fetched at build time from a Release asset, not copied in.
deploy/seed
deploy/*.tar.gz
data/_example_products.json
