# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productchat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=productchat

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=products

# Mistral AI — used for EMBEDDINGS (retrieval) always, and for CHAT when
# LLM_PROVIDER=mistral. Configure via UI or set defaults.
MISTRAL_API_KEY=your_api_key_here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TEMPERATURE=0.7
MISTRAL_MAX_TOKENS=1000

# Chat LLM provider: "mistral" (default) or "groq". Groq is an OpenAI-compatible,
# free chat API — use it when the Mistral chat tier is capped but embeddings
# still work. Embeddings ALWAYS stay on Mistral. Groq model ids must exist on
# your account (GET https://api.groq.com/openai/v1/models).
LLM_PROVIDER=mistral
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# Hybrid dense+BM25 retrieval (off by default). Fixes recall on exact terms like
# "Unterputz" that pure vector search dilutes. Set true to force-enable it
# everywhere (also works via the `enable_hybrid_search` setting in the Admin UI).
ENABLE_HYBRID_SEARCH=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
# Must be a valid Fernet key (used to encrypt the Mistral API key at rest).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-encryption-key-here
# Token for admin/write endpoints (sent as the X-Admin-Token header). Leave empty
# only in development; set a strong value in production.
ADMIN_TOKEN=

# Application
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379/0
